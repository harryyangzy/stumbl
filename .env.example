# Metrolinx Open Data API subscription key (required for GO Transit realtime/schedules).
# Register at https://opendata.metrolinx.com/ — do not commit your real key.
EXPO_PUBLIC_METROLINX_API_KEY=

# Google Maps Routes API key (LTC live times). Restrict it to iOS app ca.stumbl.app + Routes API only.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
