{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "prebuildCommand": "npx expo prebuild --platform ios --clean",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_NO_WIDGETS": "0"
      }
    },
    "preview": {
      "prebuildCommand": "npx expo prebuild --platform ios --clean",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_NO_WIDGETS": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6779780410"
      }
    }
  }
}
